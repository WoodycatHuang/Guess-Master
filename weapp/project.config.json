{
  "miniprogramRoot": "dist/",
  "projectname": "guess-master-weapp",
  "description": "桌游脑波专家 · 微信小程序",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": false,
    "skylineRenderEnable": false,
    "postcss": true,
    "minified": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "ignoreDevUnusedFiles": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "suffix", "value": ".ts" }
    ],
    "include": []
  },
  "editorSetting": {}
}
