{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/*"]
    },
    "typeRoots": ["./game-src/types", "./node_modules/@types"]
  },
  "include": ["game-src/**/*.ts"]
}
